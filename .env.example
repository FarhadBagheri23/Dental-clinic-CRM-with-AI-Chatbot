# Copy to .env and change every value before deploying.
#   cp .env.example .env

# ---- MongoDB ----------------------------------------------------------
MONGO_ROOT_USERNAME=clinic_admin
MONGO_ROOT_PASSWORD=change-me-strong-password
MONGO_DB=dental_clinic
MONGO_PORT=27017

# ---- Database account used by the API ---------------------------------
# The API authenticates as this least-privilege user (readWrite on MONGO_DB
# only), never as the root account above: it reads analytics and writes one
# collection, so it has no business being able to drop the database. Created
# by the seeder, which is the only service holding root credentials.
#   openssl rand -hex 24
API_DB_USERNAME=clinic_api
API_DB_PASSWORD=replace-with-openssl-rand-hex-24

# ---- BI panel login (created by the seeder) ---------------------------
# English letters and digits only — the login form rejects Persian input.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-too

# ---- Session signing key ----------------------------------------------
# Anyone holding this can forge a valid session for any user, so treat it
# like a password. Rotating it logs everyone out, which is the point.
# Generate a fresh one:  openssl rand -hex 32
SESSION_SECRET=replace-with-openssl-rand-hex-32

# Set true once TLS terminates in front of the panel; the session cookie is
# then refused over plain http.
COOKIE_SECURE=false

# ---- AI assistant (AvalAI) ---------------------------------------------
# Optional. Leave blank and the panel runs normally with the chat tab off.
# Key: https://chat.avalai.ir/platform/home -> API Keys -> new project key.
# Never commit this; it bills real money.
AVALAI_API_KEY=
AVALAI_BASE_URL=https://api.avalai.ir/v1
# Resolve the exact id once, then paste it here:
#   curl -s https://api.avalai.ir/v1/models \
#     -H "Authorization: Bearer $AVALAI_API_KEY" | jq -r '.data[].id'
AVALAI_MODEL=

# ---- Ports -------------------------------------------------------------
WEB_PORT=8080    # BI panel  (login required)
SITE_PORT=3000   # public clinic site
